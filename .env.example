# Copia este archivo como .env.local y llena los valores.
# Sin estas variables la app corre en MODO DEMO (datos locales del navegador).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave publicable (sb_publishable_…) o anon key: es pública por diseño, la seguridad está en RLS.
VITE_SUPABASE_ANON_KEY=tu-llave-publicable

# Las llaves de Wompi NO van aquí: son secretos de las Edge Functions (`npx supabase secrets set …`, ver README).
